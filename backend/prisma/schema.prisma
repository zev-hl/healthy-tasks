// Prisma schema for Healthy Tasks — Phase 1 (foundation).
// Later phases (tasks, comments, notifications) will add models here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Admin
  Manager
  Member
}

model User {
  id             String   @id @default(uuid())
  // `email` is the user's login id. Unique, required, validated as an email
  // at the application layer (see Zod schemas). Editable in place by an admin
  // (Phase 5) with a uniqueness check.
  email          String   @unique
  // First/Last name added in Phase 5. Required (non-empty) going forward, but
  // stored NOT NULL DEFAULT '' so pre-Phase-5 rows backfill to blank for an
  // admin to fill in — see the migration.
  firstName      String   @default("")
  lastName       String   @default("")
  title          String?
  jobDescription String?
  role           Role
  passwordHash   String
  isActive       Boolean  @default(true)

  // Account merge (Phase 5): when two accounts are merged, the non-surviving one
  // is deactivated (never deleted) and points here at the account it was merged
  // into, so historical references still resolve to a labeled, redirected user.
  mergedIntoId String?
  mergedInto   User?   @relation("AccountMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   User[]  @relation("AccountMerge")

  // Self-referential supervisor relationship. The rule "supervisor must be a
  // Manager or Admin" is enforced in the application layer (user.service.ts),
  // because it depends on another row's `role` and cannot be expressed as a
  // plain Postgres CHECK constraint. See README for an optional DB trigger.
  supervisorId String?
  supervisor   User?   @relation("Supervision", fields: [supervisorId], references: [id], onDelete: SetNull)
  reports      User[]  @relation("Supervision")

  // Bumped whenever we want to invalidate all existing JWTs for this user
  // (e.g. on deactivation or password reset). The auth middleware compares the
  // token's version to this value, giving stateless JWTs a revocation path.
  tokenVersion Int @default(0)

  passwordResetTokens PasswordResetToken[]

  // Task relations (Phase 2).
  createdTasks  Task[] @relation("TaskCreator")
  assignedTasks Task[] @relation("TaskAssignee")

  // Phase 10 review workflow: tasks this user sent to Review, and tasks holding
  // this user as their pre-review assignee (restored when review ends).
  reviewInitiatedTasks Task[] @relation("TaskReviewInitiator")
  priorAssignedTasks   Task[] @relation("TaskPriorAssignee")

  // Attachments & comments (Phase 4).
  uploadedAttachments Attachment[]     @relation("AttachmentUploader")
  authoredComments    Comment[]        @relation("CommentAuthor")
  commentMentions     CommentMention[]
  mentionEvents       MentionEvent[]

  // Change-history entries this user authored (Phase 5).
  taskHistoryEntries TaskHistory[] @relation("HistoryActor")

  // Per-screen saved UI state (filters/sort/columns/pagination) — Phase 6.
  screenPrefs UserScreenPref[]

  // Notifications (Phase 8): received notifications, personal reminders, and
  // this user's per-list notification preferences.
  notifications          Notification[]
  reminders              Reminder[]
  notificationPreference NotificationPreference?

  // Task templates authored by this user (Phase 11).
  createdTemplates TaskTemplate[] @relation("TemplateCreator")

  // SMART goals (Phase 12): goals this user owns, drafted, approved, or resolved.
  ownedGoals    Goal[] @relation("GoalOwner")
  createdGoals  Goal[] @relation("GoalCreator")
  approvedGoals Goal[] @relation("GoalApprover")
  resolvedGoals Goal[] @relation("GoalResolver")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supervisorId])
  @@index([mergedIntoId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Only a SHA-256 hash of the token is stored; the raw token lives only in the
  // emailed link. This prevents DB reads from yielding usable reset tokens.
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum TaskPriority {
  Urgent
  High
  Medium
  Low
}

// Enum keys are space-free; the UI maps InProgress/OnHold to "In Progress" /
// "On Hold" (see TASK_STATUS_LABELS in @healthy-tasks/shared).
enum TaskStatus {
  Open
  InProgress
  OnHold
  Review
  Completed
  Canceled
}

model Task {
  // Plain sequential integer id, as specified for Phase 2.
  id          Int     @id @default(autoincrement())
  name        String
  // Rich text as sanitized HTML (Phase 4): bold/italic/underline only. Always
  // sanitized server-side on write; see backend/src/utils/rich-text.ts.
  description String?

  // Creator is set to the authenticated user at creation and never changes.
  creatorId String
  creator   User   @relation("TaskCreator", fields: [creatorId], references: [id])

  // Assignee is optional and chosen from active users.
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  priority TaskPriority @default(Medium)
  status   TaskStatus   @default(Open)

  // Set to now() whenever `status` changes; stays null until the first change
  // (enforced in task.service.ts).
  statusChangedAt DateTime?

  // Free-text tags; no search integration yet (Phase 6).
  tags String[] @default([])

  startAt DateTime?
  dueAt   DateTime?

  // --- Review workflow (Phase 10) ---
  // Populated only while status == Review, cleared when the task leaves Review.
  // reviewInitiator = who sent it to Review (audit/context only). priorAssignee
  // + priorStatus record what to restore when the Reviewed/Recall button fires.
  reviewInitiatorId String?
  reviewInitiator   User?       @relation("TaskReviewInitiator", fields: [reviewInitiatorId], references: [id], onDelete: SetNull)
  priorAssigneeId   String?
  priorAssignee     User?       @relation("TaskPriorAssignee", fields: [priorAssigneeId], references: [id], onDelete: SetNull)
  priorStatus       TaskStatus?

  // --- Parent/Child hierarchy (Phase 3) ---
  // One optional parent; children are derived (tasks whose parent is this one).
  // Circular ancestry is prevented in the application layer (task.service.ts).
  parentId Int?
  parent   Task?  @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Task[] @relation("TaskHierarchy")

  // --- Dependencies (Phase 3), separate from the hierarchy above ---
  // `blocking`  = edges where this task is the blocker (its "Blocks" list).
  // `blockedBy` = edges where this task is the blocked (its "Is Blocked By"
  //               predecessors). Cycles are prevented in the application layer.
  blocking  TaskDependency[] @relation("Blocker")
  blockedBy TaskDependency[] @relation("Blocked")

  // Attachments, comments, and mention events (Phase 4).
  attachments   Attachment[]
  comments      Comment[]
  mentionEvents MentionEvent[]

  // Change history (Phase 5).
  history TaskHistory[]

  // Notifications & reminders (Phase 8).
  notifications Notification[]
  reminders     Reminder[]

  // --- Templates & recurrence (Phase 11) ---
  // Provenance for tasks generated from a Task Template. `instanceLabel` is the
  // PO/order/batch label chosen at instantiation: it is prefixed onto `name`
  // AND kept here as its own filterable field (so search can target it without
  // parsing the name). templateNode/templateOccurrence trace a generated task
  // back to the definition node and the specific instantiation it came from.
  instanceLabel        String?
  templateId           Int?
  template             TaskTemplate?       @relation("TaskFromTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  templateNodeId       Int?
  templateNode         TaskTemplateNode?   @relation("TaskFromTemplateNode", fields: [templateNodeId], references: [id], onDelete: SetNull)
  templateOccurrenceId Int?
  templateOccurrence   TemplateOccurrence? @relation("TaskFromOccurrence", fields: [templateOccurrenceId], references: [id], onDelete: SetNull)
  // Back-relation: the occurrence (if any) whose ROOT task this is.
  occurrenceRootOf     TemplateOccurrence? @relation("OccurrenceRoot")

  // Task-level recurrence (Phase 11). A regular task can be set to recur: it is
  // occurrence #1 (the live instance) and its `recurrence` rule generates future
  // instances, which point back via recurrenceSourceId and carry a 1-based
  // recurrenceSeq (2, 3, …). Ghosts are the not-yet-generated future ones.
  recurrence            TaskRecurrence? @relation("TaskRecurrenceSource")
  recurrenceSourceId    Int?
  recurrenceSource      Task?           @relation("TaskRecurrenceOccurrences", fields: [recurrenceSourceId], references: [id], onDelete: SetNull)
  recurrenceOccurrences Task[]          @relation("TaskRecurrenceOccurrences")
  recurrenceSeq         Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([assigneeId])
  @@index([status])
  @@index([parentId])
  // Phase 10 review-workflow FK indexes (created by the Phase 10 migration but
  // never declared here — Phase 12 reconciles the drift so `prisma migrate` is
  // clean; no DB change, the indexes already exist everywhere).
  @@index([reviewInitiatorId])
  @@index([priorAssigneeId])
  // Phase 6: support the Search screen's sort/filter columns.
  @@index([priority])
  @@index([dueAt])
  @@index([startAt])
  @@index([statusChangedAt])
  @@index([createdAt])
  // Phase 11: filter/trace generated tasks.
  @@index([templateId])
  @@index([templateNodeId])
  @@index([templateOccurrenceId])
  @@index([instanceLabel])
  @@index([recurrenceSourceId])
  // Claim guard: one task per (source, seq) so concurrent scheduler ticks can't
  // double-generate an occurrence. Both null for ordinary tasks (Postgres treats
  // nulls as distinct, so plain tasks never collide).
  @@unique([recurrenceSourceId, recurrenceSeq])
}

// A directed dependency edge: `blocker` must reach a terminal status before
// `blocked` may move to Review/Completed. Distinct from Parent/Child.
model TaskDependency {
  id        Int  @id @default(autoincrement())
  blockerId Int
  blockedId Int
  blocker   Task @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   Task @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// ---------------------------------------------------------------------------
// Attachments & comments (Phase 4)
// ---------------------------------------------------------------------------

// A file attached to either a Task or a Comment (exactly one parent). File bytes
// live in S3-compatible object storage under `storageKey`; only metadata is
// stored here. A DB CHECK (added in the migration) enforces that exactly one of
// taskId/commentId is set. Deleting the parent cascades the row; the service
// layer deletes the storage object alongside it.
model Attachment {
  id          String @id @default(uuid())
  filename    String
  contentType String
  size        Int
  storageKey  String @unique

  uploadedById String
  uploadedBy   User   @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  taskId Int?
  task   Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([commentId])
  @@index([uploadedById])
}

// A comment on a task. `body` is sanitized rich-text HTML (Phase 4). `editedAt`
// is null until the first edit; the displayed timestamp is editedAt ?? createdAt
// and a non-null editedAt drives the "edited" indicator.
model Comment {
  id       String @id @default(uuid())
  taskId   Int
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("CommentAuthor", fields: [authorId], references: [id])
  body     String

  attachments   Attachment[]
  mentions      CommentMention[]
  mentionEvents MentionEvent[]
  // Notifications generated from @mentions in this comment (Phase 8).
  notifications Notification[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?

  @@index([taskId])
  @@index([authorId])
}

// The set of users currently @mentioned in a comment (recomputed from the
// sanitized body on each save). Used to diff new vs retained mentions on edit.
model CommentMention {
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([commentId, userId])
  @@index([userId])
}

// Append-only record that a user was @mentioned in a comment at a point in time.
// Phase 8 builds the "Mentioned" list from these. A new mention always writes an
// event; a retained mention only writes another once 15+ minutes have passed
// since the last event for that (user, comment) pair.
model MentionEvent {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    Int
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, commentId, createdAt])
}

// ---------------------------------------------------------------------------
// Change history (Phase 5)
// ---------------------------------------------------------------------------

// The kind of change an entry records:
//  - `updated`: a value changed → previousValue/newValue are populated.
//  - `added` / `removed`: something was attached/detached (a relationship,
//    attachment, comment) → `detail` names it; previous/new are left null.
enum TaskHistoryChangeType {
  updated
  added
  removed
}

// One append-only audit entry per change to a task. Written by a single central
// helper (task-history.service.ts) called from every task-mutating endpoint, so
// capture lives in one place rather than being scattered. Description and
// comment text are deliberately never stored here — only that a change occurred.
model TaskHistory {
  id     String @id @default(uuid())
  taskId Int
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Who made the change. Nullable + SetNull so a (soft-deleted) actor never
  // blocks writes; in practice this is always the acting user, and an account
  // merge repoints these to the surviving account.
  userId String?
  user   User?   @relation("HistoryActor", fields: [userId], references: [id], onDelete: SetNull)

  changedAt DateTime @default(now())

  // Which attribute changed, e.g. `status`, `priority`, `assignee`, `dueAt`,
  // `parentTask`, `dependency:blocks`, `dependency:isBlockedBy`, `attachment`,
  // `comment`, `description`, or `merge`. Free-form string; known keys live in
  // @healthy-tasks/shared (TASK_HISTORY_FIELDS).
  field      String
  changeType TaskHistoryChangeType

  // Populated only for `updated` changes (null for added/removed).
  previousValue String?
  newValue      String?

  // For `added`/`removed`: the identifier of what changed (a task ref, a
  // filename, etc.). Null for `updated`.
  detail String?

  @@index([taskId, changedAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Per-user screen preferences (Phase 6)
// ---------------------------------------------------------------------------

// Saved UI state for a screen (Task Search, Users), per user. `state` is opaque
// JSON whose shape is owned by the frontend (search text, filters, sort order,
// column layout, page size/position). One row per (user, screen).
model UserScreenPref {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'task-search' | 'users' (see SCREEN_KEYS in @healthy-tasks/shared).
  screen String
  state  Json

  updatedAt DateTime @updatedAt

  @@unique([userId, screen])
}

// ---------------------------------------------------------------------------
// Notifications (Phase 8)
// ---------------------------------------------------------------------------

// The kinds of notification that generate an inbox entry. Status-change
// notifications are explicitly out of scope; only these three exist.
enum NotificationType {
  mentioned
  assigned
}

// For an `assigned` notification: whether the recipient was added or removed as
// the task's assignee.
enum AssignAction {
  added
  removed
}

// A recipient-centric notification for the Mentioned and Assigned lists. Rows
// are generated at event time (a mention firing, or an assignee change) only
// when the recipient is opted in to that list, and carry their own read state.
// Reminders are NOT stored here — they are a standing, time-conditional config
// (see the Reminder model).
model Notification {
  id     String           @id @default(uuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  taskId Int
  task   Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // `mentioned` only: the comment that mentioned the user (drives the list's
  // timestamp / author / text columns).
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // `assigned` only: whether the user was added or removed as assignee.
  assignAction AssignAction?

  // The user who caused this notification (the assigner). Stored as a plain id
  // and resolved to a display ref when the list is built; null for older rows.
  actorId String?

  // Null until read; set when the user clicks through to the task.
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, type, createdAt])
  @@index([taskId])
  @@index([commentId])
}

// A personal reminder a user attaches to a task. Multiple per (user, task) are
// allowed. It surfaces in the user's Reminders list only once the current time
// reaches (task.startAt - leadMinutes); a task with no startAt never surfaces.
model Reminder {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId Int
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Lead time (minutes before the task's Start Date/Time) at which to surface.
  leadMinutes Int

  // Read state once the reminder has surfaced; set on click-through.
  readAt DateTime?
  // Stamped when the "also email me" reminder email was sent — sent once, when
  // the reminder first becomes due (detected during the polling heartbeat).
  emailSentAt DateTime?
  // When set and in the future, the reminder is hidden from the due list until
  // this time (user snoozed it).
  snoozedUntil DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([taskId])
}

// Per-user opt-in for each of the three lists, plus a per-list "also email me"
// flag. Absent row ⇒ defaults (in-app on, email off) for every list.
model NotificationPreference {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mentionedInApp Boolean @default(true)
  mentionedEmail Boolean @default(false)
  remindersInApp Boolean @default(true)
  remindersEmail Boolean @default(false)
  assignedInApp  Boolean @default(true)
  assignedEmail  Boolean @default(false)
}

// ---------------------------------------------------------------------------
// Task templates & recurring tasks (Phase 11)
// ---------------------------------------------------------------------------

// How a template's occurrences are scheduled. `None` = a manual-only template
// (instantiated on demand, never auto-generated). `Fixed` = a calendar cadence
// (every N days/weeks/months from the anchor), fully computable in advance.
// `RelativeToCompletion` = the next occurrence is scheduled only once the prior
// instance's root task is Completed, so future dates are not computable ahead.
enum TemplateRecurrenceType {
  None
  Fixed
  RelativeToCompletion
}

enum RecurrenceUnit {
  Day
  Week
  Month
  Year
}

// End condition for a recurrence. `Never` recurs indefinitely; `OnDate` stops
// once an occurrence's anchor would fall after `endDate`; `AfterOccurrences`
// stops after `maxOccurrences` scheduled instantiations.
enum RecurrenceEndType {
  Never
  OnDate
  AfterOccurrences
}

// How an occurrence came to be: a user-driven manual instantiation, or an
// automatic scheduled fire. Only `scheduled` occurrences carry a `seq` and count
// toward the occurrence limit.
enum TemplateOccurrenceOrigin {
  manual
  scheduled
}

// A reusable, non-live task-tree definition. It is NOT a real Task — it is not
// searchable/assignable and never appears on Kanban/Dashboard until instantiated
// into real tasks. Managed by Admin/Manager only (enforced in the service +
// route). Recurrence fields are all null/None for a manual-only template.
model TaskTemplate {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  // Author (Admin/Manager). Set at creation, never changes.
  createdById String
  createdBy   User   @relation("TemplateCreator", fields: [createdById], references: [id])

  // --- Recurrence config (null/None ⇒ manual-only) ---
  recurrenceType TemplateRecurrenceType @default(None)
  intervalCount  Int?
  intervalUnit   RecurrenceUnit?
  // For a weekly interval, the specific weekdays it repeats on (0=Sun … 6=Sat).
  // Empty ⇒ repeats on the anchor's own weekday. Ignored for non-weekly units.
  weekdays       Int[]           @default([])
  // Start of the series: the first occurrence's anchor (its "instantiation
  // date", from which node offsets are measured).
  anchorDate     DateTime?
  endType        RecurrenceEndType @default(Never)
  endDate        DateTime?
  maxOccurrences Int?
  // How long before an occurrence's anchor to auto-materialize it into real
  // tasks (so it reliably reaches Kanban/assignee lists in time). Default 2 wks.
  leadTimeDays   Int @default(14)
  // Optional label prefix applied to scheduled occurrences ("BATCH" ⇒ "BATCH-1:
  // …"); manual instantiations always supply their own label instead.
  labelPrefix    String?
  // Paused series generate no new scheduled occurrences (existing ones remain).
  isActive       Boolean @default(true)

  nodes       TaskTemplateNode[]
  occurrences TemplateOccurrence[]
  tasks       Task[] @relation("TaskFromTemplate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([recurrenceType])
}

// One definition node in a template's tree. Mirrors the real Task parent/child
// hierarchy via a self-relation. Dates are RELATIVE offsets (in days) from the
// instantiation anchor, not fixed dates. `assigneeRole` is a free-text job-role
// placeholder ("Inspector"), resolved to a real user at instantiation.
model TaskTemplateNode {
  id         Int          @id @default(autoincrement())
  templateId Int
  template   TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // Self-relation for the definition tree (mirrors Task "TaskHierarchy").
  parentNodeId Int?
  parentNode   TaskTemplateNode?  @relation("TemplateNodeHierarchy", fields: [parentNodeId], references: [id], onDelete: Cascade)
  childNodes   TaskTemplateNode[] @relation("TemplateNodeHierarchy")

  name            String
  description     String?
  defaultPriority TaskPriority @default(Medium)
  // Day offsets from the occurrence anchor; null ⇒ that date is left unset.
  startOffsetDays Int?
  dueOffsetDays   Int?
  // Free-text role placeholder (not a user, not the permission Role enum).
  assigneeRole    String?
  // Sibling ordering within a parent.
  orderIndex      Int @default(0)

  // Dependencies between nodes of the SAME template (carried through to the
  // generated task tree). Mirrors TaskDependency.
  blocking  TaskTemplateDependency[] @relation("TemplateBlocker")
  blockedBy TaskTemplateDependency[] @relation("TemplateBlocked")

  generatedTasks Task[] @relation("TaskFromTemplateNode")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@index([parentNodeId])
}

// A directed dependency edge between two nodes of the same template (blocker
// must precede blocked). Mirrors TaskDependency; carried into the generated
// tasks' real TaskDependency edges at instantiation.
model TaskTemplateDependency {
  id            Int              @id @default(autoincrement())
  blockerNodeId Int
  blockedNodeId Int
  blockerNode   TaskTemplateNode @relation("TemplateBlocker", fields: [blockerNodeId], references: [id], onDelete: Cascade)
  blockedNode   TaskTemplateNode @relation("TemplateBlocked", fields: [blockedNodeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerNodeId, blockedNodeId])
  @@index([blockerNodeId])
  @@index([blockedNodeId])
}

// A materialized instantiation of a template into a real task tree. Recorded so
// we can count scheduled occurrences toward the limit, find the prior instance's
// assignees to carry forward, and detect prior-root completion for
// relative-to-completion series. Ghosts (future, not-yet-materialized) are NOT
// rows here — they are computed on the fly and never persisted.
model TemplateOccurrence {
  id         Int          @id @default(autoincrement())
  templateId Int
  template   TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // 1-based schedule index for a `scheduled` occurrence; NULL for a `manual`
  // one (so manual instantiations neither collide on the unique index nor count
  // toward the occurrence limit).
  seq    Int?
  origin TemplateOccurrenceOrigin

  instanceLabel String?
  // The resolved anchor (instantiation date) for this occurrence; node offsets
  // are measured from here.
  anchorStart DateTime

  // The generated root task. SetNull if it is later hard-deleted.
  rootTaskId Int?  @unique
  rootTask   Task? @relation("OccurrenceRoot", fields: [rootTaskId], references: [id], onDelete: SetNull)

  // Every task generated for this occurrence (root + descendants).
  tasks Task[] @relation("TaskFromOccurrence")

  materializedAt DateTime @default(now())

  @@unique([templateId, seq])
  @@index([templateId])
}

// Singleton (id = 1) health record for the recurrence scheduler. `lastTickAt` is
// stamped every timer run; the notifications heartbeat reads it and, if it has
// gone stale, alerts admins that the background timer is down. `lastAlertAt`
// dedups those alerts (cooldown) so a persistent outage does not spam.
model SchedulerState {
  id          Int       @id @default(1)
  lastTickAt  DateTime?
  lastAlertAt DateTime?
  updatedAt   DateTime  @updatedAt
}

// A recurrence rule attached directly to a regular task (Phase 11). The task is
// the definition AND occurrence #1; this row drives generation of future
// instances. `recurrenceType` here is always Fixed or RelativeToCompletion
// (absence of a row = not recurring). `anchorDate` is the source task's earliest
// date (start ?? due) — the reference for the lead-time window, per the product
// definition of a "ghost" (earliest date more than the lead time out).
model TaskRecurrence {
  id     Int  @id @default(autoincrement())
  taskId Int  @unique
  task   Task @relation("TaskRecurrenceSource", fields: [taskId], references: [id], onDelete: Cascade)

  recurrenceType TemplateRecurrenceType
  intervalCount  Int
  intervalUnit   RecurrenceUnit
  // Weekly-only: weekdays it repeats on (0=Sun … 6=Sat); empty ⇒ the anchor's day.
  weekdays       Int[]             @default([])
  anchorDate     DateTime
  endType        RecurrenceEndType @default(Never)
  endDate        DateTime?
  maxOccurrences Int?
  leadTimeDays   Int               @default(14)
  isActive       Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// SMART Goals (Phase 12)
// ---------------------------------------------------------------------------

// A goal's lifecycle status. Draft (editable by its creator/owner) →
// PendingApproval (submitted to the supervisor) → Approved (Active; the employee
// updates Results/Notes/Risks/Mitigations) → UnderReview (entered automatically
// when the deadline passes, or immediately when the employee marks Results final
// — whichever comes first) → Resolved (the supervisor set Resolution + Comments).
// Resolved is terminal: it is never silently rewritten (a correction is a
// deliberate one-off edit), consistent with how history is treated elsewhere.
// A PendingApproval goal can instead be rejected back to Draft with comments.
enum GoalStatus {
  Draft
  PendingApproval
  Approved
  UnderReview
  Resolved
}

// The metric a goal's target and result are measured in. `Other` carries a
// free-text `unitLabel`; the others imply their unit (Count = a plain number,
// Percentage = %, Currency = money, Frequency = times per period).
enum GoalMetricType {
  Count
  Percentage
  Frequency
  Currency
  Other
}

// The supervisor's verdict, set only on the transition to Resolved.
enum GoalResolution {
  Exceeded
  Met
  Missed
  PartiallyMet
  InProgress
}

// A SMART goal that belongs to an employee. Fully independent of the Task system
// in this phase. Either the employee or their supervisor may draft one for the
// employee, but the supervisor must always approve it before it becomes Active.
// Visibility: the owner sees their own; a supervisor sees goals whose owner's
// `supervisorId` is them (direct reports only); admins see all.
model Goal {
  id Int @id @default(autoincrement())

  // The employee the goal belongs to.
  ownerId String
  owner   User   @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Whoever drafted the goal (the employee or their supervisor). Set at creation
  // and never changes.
  createdById String
  createdBy   User   @relation("GoalCreator", fields: [createdById], references: [id])

  // --- SMART fields ---
  // What (Specific).
  specific String
  // How Much (Measurable): a metric type + a target value in that unit, plus a
  // free-text unit label (required when metricType is `Other`).
  metricType  GoalMetricType
  unitLabel   String?
  targetValue Float
  // By When (Time-bound): the deadline. In this phase the deadline alone is the
  // review period — there is no separate review-cycle entity.
  deadline DateTime

  risks       String?
  mitigations String?
  // Editable throughout the goal's life (until it is Resolved).
  notes String?

  // Results: the actuals, in the same metric type/unit as the target. Entered and
  // updatable by the employee while the goal is Approved (Active).
  resultValue Float?
  // Stamped when the employee marks Results final — this forces the Under-Review
  // transition even before the deadline.
  resultsFinalizedAt DateTime?

  // Resolution + Supervisor Comments: set by the supervisor when reviewing
  // Results, moving the goal to Resolved.
  resolution         GoalResolution?
  supervisorComments String?

  // The supervisor's required reason when rejecting a PendingApproval goal back to
  // Draft. Left visible on the returned draft so the employee can address it and
  // resubmit.
  rejectionComments String?

  status GoalStatus @default(Draft)

  // Workflow audit stamps (who / when for each significant transition). The
  // approver/resolver are SetNull so a deactivated supervisor never blocks reads.
  submittedAt   DateTime?
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    User?     @relation("GoalApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  underReviewAt DateTime?
  resolvedAt    DateTime?
  resolvedById  String?
  resolvedBy    User?     @relation("GoalResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([createdById])
  @@index([status])
  @@index([deadline])
}
