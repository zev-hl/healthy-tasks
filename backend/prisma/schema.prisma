// Prisma schema for Healthy Tasks — Phase 1 (foundation).
// Later phases (tasks, comments, notifications) will add models here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Admin
  Manager
  Member
}

model User {
  id             String   @id @default(uuid())
  // `email` is the user's login id. Unique, required, validated as an email
  // at the application layer (see Zod schemas). Editable in place by an admin
  // (Phase 5) with a uniqueness check.
  email          String   @unique
  // First/Last name added in Phase 5. Required (non-empty) going forward, but
  // stored NOT NULL DEFAULT '' so pre-Phase-5 rows backfill to blank for an
  // admin to fill in — see the migration.
  firstName      String   @default("")
  lastName       String   @default("")
  title          String?
  jobDescription String?
  role           Role
  passwordHash   String
  isActive       Boolean  @default(true)

  // Account merge (Phase 5): when two accounts are merged, the non-surviving one
  // is deactivated (never deleted) and points here at the account it was merged
  // into, so historical references still resolve to a labeled, redirected user.
  mergedIntoId String?
  mergedInto   User?   @relation("AccountMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   User[]  @relation("AccountMerge")

  // Self-referential supervisor relationship. The rule "supervisor must be a
  // Manager or Admin" is enforced in the application layer (user.service.ts),
  // because it depends on another row's `role` and cannot be expressed as a
  // plain Postgres CHECK constraint. See README for an optional DB trigger.
  supervisorId String?
  supervisor   User?   @relation("Supervision", fields: [supervisorId], references: [id], onDelete: SetNull)
  reports      User[]  @relation("Supervision")

  // Bumped whenever we want to invalidate all existing JWTs for this user
  // (e.g. on deactivation or password reset). The auth middleware compares the
  // token's version to this value, giving stateless JWTs a revocation path.
  tokenVersion Int @default(0)

  passwordResetTokens PasswordResetToken[]

  // Task relations (Phase 2).
  createdTasks  Task[] @relation("TaskCreator")
  assignedTasks Task[] @relation("TaskAssignee")

  // Attachments & comments (Phase 4).
  uploadedAttachments Attachment[]     @relation("AttachmentUploader")
  authoredComments    Comment[]        @relation("CommentAuthor")
  commentMentions     CommentMention[]
  mentionEvents       MentionEvent[]

  // Change-history entries this user authored (Phase 5).
  taskHistoryEntries TaskHistory[] @relation("HistoryActor")

  // Per-screen saved UI state (filters/sort/columns/pagination) — Phase 6.
  screenPrefs UserScreenPref[]

  // Notifications (Phase 8): received notifications, personal reminders, and
  // this user's per-list notification preferences.
  notifications          Notification[]
  reminders              Reminder[]
  notificationPreference NotificationPreference?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supervisorId])
  @@index([mergedIntoId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Only a SHA-256 hash of the token is stored; the raw token lives only in the
  // emailed link. This prevents DB reads from yielding usable reset tokens.
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum TaskPriority {
  Urgent
  High
  Medium
  Low
}

// Enum keys are space-free; the UI maps InProgress/OnHold to "In Progress" /
// "On Hold" (see TASK_STATUS_LABELS in @healthy-tasks/shared).
enum TaskStatus {
  Open
  InProgress
  OnHold
  Review
  Completed
  Canceled
}

model Task {
  // Plain sequential integer id, as specified for Phase 2.
  id          Int     @id @default(autoincrement())
  name        String
  // Rich text as sanitized HTML (Phase 4): bold/italic/underline only. Always
  // sanitized server-side on write; see backend/src/utils/rich-text.ts.
  description String?

  // Creator is set to the authenticated user at creation and never changes.
  creatorId String
  creator   User   @relation("TaskCreator", fields: [creatorId], references: [id])

  // Assignee is optional and chosen from active users.
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  priority TaskPriority @default(Medium)
  status   TaskStatus   @default(Open)

  // Set to now() whenever `status` changes; stays null until the first change
  // (enforced in task.service.ts).
  statusChangedAt DateTime?

  // Free-text tags; no search integration yet (Phase 6).
  tags String[] @default([])

  startAt DateTime?
  dueAt   DateTime?

  // --- Parent/Child hierarchy (Phase 3) ---
  // One optional parent; children are derived (tasks whose parent is this one).
  // Circular ancestry is prevented in the application layer (task.service.ts).
  parentId Int?
  parent   Task?  @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Task[] @relation("TaskHierarchy")

  // --- Dependencies (Phase 3), separate from the hierarchy above ---
  // `blocking`  = edges where this task is the blocker (its "Blocks" list).
  // `blockedBy` = edges where this task is the blocked (its "Is Blocked By"
  //               predecessors). Cycles are prevented in the application layer.
  blocking  TaskDependency[] @relation("Blocker")
  blockedBy TaskDependency[] @relation("Blocked")

  // Attachments, comments, and mention events (Phase 4).
  attachments   Attachment[]
  comments      Comment[]
  mentionEvents MentionEvent[]

  // Change history (Phase 5).
  history TaskHistory[]

  // Notifications & reminders (Phase 8).
  notifications Notification[]
  reminders     Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([assigneeId])
  @@index([status])
  @@index([parentId])
  // Phase 6: support the Search screen's sort/filter columns.
  @@index([priority])
  @@index([dueAt])
  @@index([startAt])
  @@index([statusChangedAt])
  @@index([createdAt])
}

// A directed dependency edge: `blocker` must reach a terminal status before
// `blocked` may move to Review/Completed. Distinct from Parent/Child.
model TaskDependency {
  id        Int  @id @default(autoincrement())
  blockerId Int
  blockedId Int
  blocker   Task @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   Task @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// ---------------------------------------------------------------------------
// Attachments & comments (Phase 4)
// ---------------------------------------------------------------------------

// A file attached to either a Task or a Comment (exactly one parent). File bytes
// live in S3-compatible object storage under `storageKey`; only metadata is
// stored here. A DB CHECK (added in the migration) enforces that exactly one of
// taskId/commentId is set. Deleting the parent cascades the row; the service
// layer deletes the storage object alongside it.
model Attachment {
  id          String @id @default(uuid())
  filename    String
  contentType String
  size        Int
  storageKey  String @unique

  uploadedById String
  uploadedBy   User   @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  taskId Int?
  task   Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([commentId])
  @@index([uploadedById])
}

// A comment on a task. `body` is sanitized rich-text HTML (Phase 4). `editedAt`
// is null until the first edit; the displayed timestamp is editedAt ?? createdAt
// and a non-null editedAt drives the "edited" indicator.
model Comment {
  id       String @id @default(uuid())
  taskId   Int
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("CommentAuthor", fields: [authorId], references: [id])
  body     String

  attachments   Attachment[]
  mentions      CommentMention[]
  mentionEvents MentionEvent[]
  // Notifications generated from @mentions in this comment (Phase 8).
  notifications Notification[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?

  @@index([taskId])
  @@index([authorId])
}

// The set of users currently @mentioned in a comment (recomputed from the
// sanitized body on each save). Used to diff new vs retained mentions on edit.
model CommentMention {
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([commentId, userId])
  @@index([userId])
}

// Append-only record that a user was @mentioned in a comment at a point in time.
// Phase 8 builds the "Mentioned" list from these. A new mention always writes an
// event; a retained mention only writes another once 15+ minutes have passed
// since the last event for that (user, comment) pair.
model MentionEvent {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    Int
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, commentId, createdAt])
}

// ---------------------------------------------------------------------------
// Change history (Phase 5)
// ---------------------------------------------------------------------------

// The kind of change an entry records:
//  - `updated`: a value changed → previousValue/newValue are populated.
//  - `added` / `removed`: something was attached/detached (a relationship,
//    attachment, comment) → `detail` names it; previous/new are left null.
enum TaskHistoryChangeType {
  updated
  added
  removed
}

// One append-only audit entry per change to a task. Written by a single central
// helper (task-history.service.ts) called from every task-mutating endpoint, so
// capture lives in one place rather than being scattered. Description and
// comment text are deliberately never stored here — only that a change occurred.
model TaskHistory {
  id     String @id @default(uuid())
  taskId Int
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Who made the change. Nullable + SetNull so a (soft-deleted) actor never
  // blocks writes; in practice this is always the acting user, and an account
  // merge repoints these to the surviving account.
  userId String?
  user   User?   @relation("HistoryActor", fields: [userId], references: [id], onDelete: SetNull)

  changedAt DateTime @default(now())

  // Which attribute changed, e.g. `status`, `priority`, `assignee`, `dueAt`,
  // `parentTask`, `dependency:blocks`, `dependency:isBlockedBy`, `attachment`,
  // `comment`, `description`, or `merge`. Free-form string; known keys live in
  // @healthy-tasks/shared (TASK_HISTORY_FIELDS).
  field      String
  changeType TaskHistoryChangeType

  // Populated only for `updated` changes (null for added/removed).
  previousValue String?
  newValue      String?

  // For `added`/`removed`: the identifier of what changed (a task ref, a
  // filename, etc.). Null for `updated`.
  detail String?

  @@index([taskId, changedAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Per-user screen preferences (Phase 6)
// ---------------------------------------------------------------------------

// Saved UI state for a screen (Task Search, Users), per user. `state` is opaque
// JSON whose shape is owned by the frontend (search text, filters, sort order,
// column layout, page size/position). One row per (user, screen).
model UserScreenPref {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'task-search' | 'users' (see SCREEN_KEYS in @healthy-tasks/shared).
  screen String
  state  Json

  updatedAt DateTime @updatedAt

  @@unique([userId, screen])
}

// ---------------------------------------------------------------------------
// Notifications (Phase 8)
// ---------------------------------------------------------------------------

// The kinds of notification that generate an inbox entry. Status-change
// notifications are explicitly out of scope; only these three exist.
enum NotificationType {
  mentioned
  assigned
}

// For an `assigned` notification: whether the recipient was added or removed as
// the task's assignee.
enum AssignAction {
  added
  removed
}

// A recipient-centric notification for the Mentioned and Assigned lists. Rows
// are generated at event time (a mention firing, or an assignee change) only
// when the recipient is opted in to that list, and carry their own read state.
// Reminders are NOT stored here — they are a standing, time-conditional config
// (see the Reminder model).
model Notification {
  id     String           @id @default(uuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  taskId Int
  task   Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // `mentioned` only: the comment that mentioned the user (drives the list's
  // timestamp / author / text columns).
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // `assigned` only: whether the user was added or removed as assignee.
  assignAction AssignAction?

  // The user who caused this notification (the assigner). Stored as a plain id
  // and resolved to a display ref when the list is built; null for older rows.
  actorId String?

  // Null until read; set when the user clicks through to the task.
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, type, createdAt])
  @@index([taskId])
  @@index([commentId])
}

// A personal reminder a user attaches to a task. Multiple per (user, task) are
// allowed. It surfaces in the user's Reminders list only once the current time
// reaches (task.startAt - leadMinutes); a task with no startAt never surfaces.
model Reminder {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId Int
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Lead time (minutes before the task's Start Date/Time) at which to surface.
  leadMinutes Int

  // Read state once the reminder has surfaced; set on click-through.
  readAt DateTime?
  // Stamped when the "also email me" reminder email was sent — sent once, when
  // the reminder first becomes due (detected during the polling heartbeat).
  emailSentAt DateTime?
  // When set and in the future, the reminder is hidden from the due list until
  // this time (user snoozed it).
  snoozedUntil DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([taskId])
}

// Per-user opt-in for each of the three lists, plus a per-list "also email me"
// flag. Absent row ⇒ defaults (in-app on, email off) for every list.
model NotificationPreference {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mentionedInApp Boolean @default(true)
  mentionedEmail Boolean @default(false)
  remindersInApp Boolean @default(true)
  remindersEmail Boolean @default(false)
  assignedInApp  Boolean @default(true)
  assignedEmail  Boolean @default(false)
}
