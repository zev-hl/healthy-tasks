# ---------------------------------------------------------------------------
# HL Central — environment variables
# Copy this file to `.env` and fill in real values for local development.
# The values below are the defaults used by docker-compose for local dev.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Standard PostgreSQL connection string. In Docker Compose this points at the
# `db` service. For a hosted DB (e.g. Neon) just replace this whole URL.
DATABASE_URL="postgresql://healthy:healthy@db:5432/healthy_tasks?schema=public"

# When running the backend OUTSIDE Docker (npm run dev:backend on your host)
# use localhost instead of the `db` service name:
# DATABASE_URL="postgresql://healthy:healthy@localhost:5432/healthy_tasks?schema=public"

# --- Backend ----------------------------------------------------------------
NODE_ENV="development"
PORT="4000"

# Secret used to sign JWT access tokens. MUST be a long random string in prod.
JWT_SECRET="dev-only-change-me-to-a-long-random-string"
# Access token lifetime. This is the idle-session window: the token is
# re-issued on every authenticated request, so it only expires after this much
# time with NO activity, then the SPA bounces to the login screen. (Deactivation
# and password resets still take effect immediately via per-request DB checks.)
JWT_EXPIRES_IN="8h"

# Password reset token lifetime.
PASSWORD_RESET_EXPIRES_IN="60m"

# Base URL of the frontend — used to build password-reset links in emails.
FRONTEND_URL="http://localhost:5173"

# CORS: which origin the browser SPA is served from.
CORS_ORIGIN="http://localhost:5173"

# --- Email ------------------------------------------------------------------
# In dev, emails are printed to the console. When you plug in a real provider
# (SendGrid, SES, Postmark, etc.) set EMAIL_PROVIDER=smtp and fill the rest.
EMAIL_PROVIDER="console"
EMAIL_FROM="HL Central <no-reply@healthy-tasks.local>"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# --- First admin (used by the seed script) ----------------------------------
SEED_ADMIN_EMAIL="admin@healthy-tasks.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Object storage for attachments (Phase 4) -------------------------------
# STORAGE_DRIVER: "s3" (MinIO locally / any S3-compatible bucket in prod) or
# "memory" (used by the test suite; no external storage required).
STORAGE_DRIVER="s3"
S3_BUCKET="healthy-tasks"
S3_REGION="us-east-1"
# Endpoint the BACKEND uses for server-side ops (delete/head). In Docker this is
# the compose service name.
S3_ENDPOINT="http://minio:9000"
# Endpoint used to SIGN upload/download URLs — must be reachable by the BROWSER,
# so it is localhost even inside Docker.
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
# Path-style addressing is required by MinIO and most S3-compatible servers.
S3_FORCE_PATH_STYLE="true"

# --- Frontend ---------------------------------------------------------------
# Vite exposes only VITE_-prefixed vars to the browser bundle.
VITE_API_URL="http://localhost:4000"
